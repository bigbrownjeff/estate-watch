HOME = os.environ.get("MEMORY_SYNC_HOME") or os.path.expanduser("~")
REL = os.path.join("projects", "-Users-jeffpinto", "memory")
PROFILES = {
    "main": os.path.join(HOME, ".claude"),
    "claudine": os.path.join(HOME, ".claude-claudine"),
    "claudette": os.path.join(HOME, ".claude-claudette"),
    # Jeff, 2026-09-07: claudeux (jeff@bluecamelconsulting.com, created 09-02)
    # is a full sister, "treated in parallel with claudette and claudine so
    # that we have symlink sisters that learn from each other". Never retire a
    # profile out of this table; the 09-06 remediation candidate adds a check
    # that every ~/.claude* store is listed here.
    "claudeux": os.path.join(HOME, ".claude-claudeux"),
}
VAULT = os.path.join(HOME, "data-vaults", "claude-memory")
LOCKDIR = os.path.join(HOME, ".claude", "failures", ".memory-sync.lockdir")
FAILTASK = os.path.join(HOME, ".claude", "bin", "failtask")
INDEX = "MEMORY.md"

SYNC_TYPES = {"feedback", "user"}
# A file touched within this many seconds may be mid-write by a live session.
FRESH_SECONDS = 120
SNAPSHOT_KEEP = 30
# Provenance default (2026-09-19). The harness writes memories with name,
# description and metadata.type only, never `status:`, so --check went red on
# every day a memory was written (23 hand-stamped 09-15, 21 more by 09-19).
# The writing runs now stamp the default `status: active` on those files. A
# fresh one waits up to STAMP_GRACE_SECONDS (the daily 08:45 run plus slack)
# before --check fails on it; after that, the stamping run is not doing its job.
STAMP_GRACE_SECONDS = 26 * 3600
# A memory whose own frontmatter says it is superseded or retired is never
# defaulted to active: that is the case the provenance gate exists to catch.
RETIRE_SIGNAL = re.compile(r"\b(superseded|retired)\b", re.I)
LOCK_STALE_SECONDS = 1800
BYTE_BUDGET = 24000

# MEM-4(b): negation-flip keyword list. NEGATORS mark "this stops/forbids";
# ASSERTORS mark "this now happens/always happens". An inserted line carrying
# one polarity that overlaps in topic with a kept line carrying the other is
# a semantic conflict, not a lossless append.
NEGATORS = ["not", "never", "no longer", "stop", "do not", "don't",
            "rescind", "superseded", "deprecated"]
ASSERTORS = ["automatically", "always"]
KEYWORDS = NEGATORS + ASSERTORS
_STOPWORDS = {"the", "and", "for", "with", "this", "that", "from", "into"}


# ---------------------------------------------------------------- store model

def memdir(profile):
    return os.path.join(PROFILES[profile], REL)


def sha(text):
    return hashlib.sha1(text.encode("utf-8")).hexdigest()


def read(path):
    with open(path, encoding="utf-8", errors="replace") as fh:
        return fh.read()


def frontmatter(text):
    """Return the metadata block as a flat dict. Deliberately tolerant: these
    files are written by several different agents and are not strict YAML."""
    m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    if not m:
        return {}
    out = {}
    for line in m.group(1).splitlines():
        kv = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*:\s*(.*?)\s*$", line)
        if kv:
            out.setdefault(kv.group(1), kv.group(2))
    return out


def eligible(text):
    """Is this memory doctrine-grade? Returns (bool, reason)."""
    fm = frontmatter(text)
    flag = fm.get("sync", "").strip().strip('"').lower()
    if flag == "false":
        return False, "sync: false"
    if flag == "true":
        return True, "sync: true"
    mtype = fm.get("type", "").strip().strip('"')
    if mtype in SYNC_TYPES:
        return True, "type: %s" % mtype
    return False, "type: %s" % (mtype or "none")


def scan():
    """{name: {profile: {text, sha, mtime, eligible, reason}}}"""
    store = {}
    for profile in PROFILES:
        d = memdir(profile)
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".md") or fn == INDEX:
                continue
            p = os.path.join(d, fn)
            if not os.path.isfile(p):
                continue
            text = read(p)
            ok, reason = eligible(text)
            store.setdefault(fn, {})[profile] = {
                "text": text,
                "sha": sha(text),
                "mtime": os.path.getmtime(p),
                "modified": frontmatter(text).get("modified", ""),
                "eligible": ok,
                "reason": reason,
                "path": p,
            }
    return store


def unregistered_profile_dirs(home=None):
    """~/.claude* directories carrying a memory index that PROFILES doesn't
    know about (MEM-2: this is exactly how claudeux went missing)."""
    home = home if home is not None else HOME
    known = set(PROFILES.values())
    out = []
    if not os.path.isdir(home):
        return out
    for entry in sorted(os.listdir(home)):
        if entry != ".claude" and not entry.startswith(".claude-"):
            continue
        d = os.path.join(home, entry)
        if not os.path.isdir(d) or d in known:
            continue
        if os.path.exists(os.path.join(d, REL, INDEX)):
            out.append(d)
    return out


# ------------------------------------------------------------ merge decisions

def _keywords_in(line):
    low = line.lower()
    return {k for k in KEYWORDS if k in low}


def _topic_words(line):
    low = re.sub(r"[^a-z0-9\s]", " ", line.lower())
    return {w for w in low.split()
            if len(w) > 2 and w not in KEYWORDS and w not in _STOPWORDS}


def negation_conflict(existing_lines, inserted_lines):
    """The first (existing_line, inserted_line) pair where an inserted line
    flips the polarity (NEGATORS vs ASSERTORS) of an existing line it shares
    topic words with, or None. Naming the offending existing line is what the
    plan prints for triage."""
    for ins in inserted_lines:
        ins_kw = _keywords_in(ins)
        if not ins_kw:
            continue
        ins_topic = _topic_words(ins)
        if not ins_topic:
            continue
        for ex in existing_lines:
            ex_kw = _keywords_in(ex)
            if not ex_kw:
                continue
            flipped = bool(ex_kw & set(NEGATORS)) != bool(ins_kw & set(NEGATORS))
            if not flipped:
                continue
            ex_topic = _topic_words(ex)
            if not ex_topic:
                continue
            overlap = ins_topic & ex_topic
            if len(overlap) >= max(1, min(len(ins_topic), len(ex_topic)) // 2):
                return ex
    return None


def superset(a, b):
    """True only if a can replace b with provably no loss: every line of b
    survives in a in the SAME ORDER (difflib opcodes against b are equal/
    insert only -- a reorder, edit, or dropped line returns False in both
    directions), and no line a inserts negation-flips a line it keeps
    (see negation_conflict). This is the no-data-loss proof behind PROMOTE."""
    if a == b:
        return False
    la, lb = a.splitlines(), b.splitlines()
    sm = difflib.SequenceMatcher(a=lb, b=la, autojunk=False)
    inserted = []
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            continue
        if tag == "insert":
            inserted.extend(la[j1:j2])
            continue
        return False  # delete/replace: b has content a doesn't keep in order
    if negation_conflict(lb, inserted):
        return False
    return True


def lost_lines(winner, loser):
    return [l for l in loser.splitlines() if l.strip() and l not in set(winner.splitlines())]


def decide(name, per_profile):
    """Return (action, winner_profile, detail).

    action in {"clean", "add", "promote", "conflict", "divergent-ineligible", "skip"}
    """
    live = dict(per_profile)
    elig = {p: v for p, v in live.items() if v["eligible"]}
    if not elig:
        return "skip", None, "not doctrine-grade in any store"
    # An explicit sync:false anywhere pins the whole memory: never overwrite a
    # profile that has deliberately opted out.
    pinned = [p for p, v in live.items() if v["reason"] == "sync: false"]
    if pinned:
        return "skip", None, "pinned local by %s" % ", ".join(sorted(pinned))

    elig_shas = {v["sha"] for v in elig.values()}

    # MEM-4(f): a store that opted this memory OUT of sync but holds
    # different content is neither "clean" (nothing to compare against) nor
    # a promotion target -- it must surface, always.
    divergent = sorted(p for p, v in live.items()
                        if not v["eligible"] and v["sha"] not in elig_shas)
    if divergent:
        detail = "; ".join("%s (%s)" % (p, live[p]["reason"]) for p in divergent)
        return ("divergent-ineligible", None,
                "ineligible copy differs from the doctrine-grade version: %s" % detail)

    missing = [p for p in PROFILES if p not in live]

    if len(elig_shas) == 1:
        if not missing:
            return "clean", None, ""
        src = sorted(elig)[0]
        return "add", src, "absent in %s" % ", ".join(sorted(missing))

    # Content differs. Find a single winner that is a superset of every other.
    winners = []
    for p, v in elig.items():
        others = [w["text"] for q, w in elig.items() if q != p]
        if all(v["text"] == o or superset(v["text"], o) for o in others):
            winners.append(p)
    winners = [p for p in winners
               if any(elig[p]["text"] != elig[q]["text"] for q in elig if q != p)]
    if len(winners) == 1:
        w = winners[0]
        tail = " and absent in %s" % ", ".join(sorted(missing)) if missing else ""
        return "promote", w, "%s is a strict line-superset of every other copy%s" % (w, tail)

    return "conflict", None, "no copy contains all the others"


# ----------------------------------------------------------------- index (MEMORY.md)

def index_path(profile):
    return os.path.join(memdir(profile), INDEX)


def index_lines(profile):
    p = index_path(profile)
    return read(p).splitlines() if os.path.exists(p) else []


def find_index_line(lines, name):
    """Index entries look like:  - [Title](file.md) — hook
    Match on the link target only; titles and hooks are free-form."""
    pat = re.compile(r"\]\(\s*%s\s*\)" % re.escape(name))
    for i, line in enumerate(lines):
        if pat.search(line):
            return i
    return -1


def line_segments(line):
    """Split a bullet index line into (prefix, [segment, ...]) on ' · ', so a
    single memory's segment can be read or replaced without touching a
    sibling memory's link on the same physical line."""
    m = re.match(r"^(\s*-\s*)(.*)$", line)
    if not m:
        return "", [line]
    return m.group(1), m.group(2).split(" · ")


def segment_for(segs, name):
    pat = re.compile(r"\]\(\s*%s\s*\)" % re.escape(name))
    for i, s in enumerate(segs):
        if pat.search(s):
            return i
    return -1


def plan_index(name, source_profile, targets):
    """[(profile, mode, name, payload)] per-target index op.

    mode 'append'  payload is a brand-new line (target has no entry yet).
    mode 'merge'   payload is only this memory's ' · ' segment, spliced into
                   the target's existing line without disturbing a sibling
                   segment -- this is the MEM-3 fix: a multi-link source line
                   no longer drags an ineligible sibling's link along.
    mode 'replace' whole-line fallback, used ONLY when the source line does
                   not split into recognizable ' · ' segments; logged, not
                   silent.
    """
    src = index_lines(source_profile)
    i = find_index_line(src, name)
    if i < 0:
        return []
    line = src[i]
    prefix, segs = line_segments(line)
    si = segment_for(segs, name)
    fallback = si < 0
    if fallback:
        print("  NOTE     %-46s index line has no ' · ' segment for this "
              "link; falling back to whole-line copy" % name, file=sys.stderr)
        seg_payload = line
    else:
        seg_payload = segs[si]

    out = []
    for p in targets:
        lines = index_lines(p)
        j = find_index_line(lines, name)
        if j < 0:
            new_line = line if fallback else (prefix + seg_payload)
            out.append((p, "append", name, new_line))
            continue
        if fallback:
            if lines[j] != line:
                out.append((p, "replace", name, line))
            continue
        tprefix, tsegs = line_segments(lines[j])
        tsi = segment_for(tsegs, name)
        if tsi >= 0 and tsegs[tsi] == seg_payload:
            continue  # already correct
        out.append((p, "merge", name, seg_payload))
    return out


def write_index(profile, name, payload, mode):
    p = index_path(profile)
    before = read(p) if os.path.exists(p) else "# Memory index\n"
    lines = before.splitlines()
    j = find_index_line(lines, name)
    if mode == "append":
        if j >= 0:
            return False
        while lines and not lines[-1].strip():
            lines.pop()
        lines.append(payload)
    elif mode == "replace":
        if j < 0:
            return False
        lines[j] = payload
    elif mode == "merge":
        if j < 0:
            return False
        prefix, segs = line_segments(lines[j])
        si = segment_for(segs, name)
        if si >= 0:
            segs[si] = payload
        else:
            segs.append(payload)
        lines[j] = prefix + " · ".join(segs)
    else:
        return False
    atomic_write(p, "\n".join(lines) + "\n", expect=before)
    return True


def index_health(store):
    """Per-registered-profile index hygiene (MEM-3, CD-R4-1: checked on every
    profile, not main only).

    Returns (dangling, unindexed, byte_over, dupes):
      dangling   [(profile, line_no, target)] index link -> file that doesn't
                 exist in that profile's store.
      unindexed  [(profile, name)] doctrine-grade memory present+eligible in
                 a profile whose index there has no entry for it.
      byte_over  {profile: (size_bytes, [line_no, ...])} profiles whose
                 MEMORY.md exceeds BYTE_BUDGET, with the lines past it.
      dupes      ["profile: target xN", ...] index links to the same target
                 appearing more than once in a profile's index (warn-only;
                 never affects the exit code — same as before this scan was
                 folded into index_health()).
    """
    dangling, unindexed = [], []
    byte_over = {}
    dupes = []
    for p in PROFILES:
        d = memdir(p)
        if not os.path.isdir(d):
            continue
        seen = {}
        for ln, line in enumerate(index_lines(p), 1):
            for target in re.findall(r"\]\(([^)]+\.md)\)", line):
                if not os.path.exists(os.path.join(d, target)):
                    dangling.append((p, ln, target))
                seen[target] = seen.get(target, 0) + 1
        dupes += ["%s: %s x%d" % (p, k, v) for k, v in sorted(seen.items()) if v > 1]
        ip = index_path(p)
        text = read(ip) if os.path.exists(ip) else ""
        size = len(text.encode("utf-8"))
        if size > BYTE_BUDGET:
            over, running = [], 0
            for ln, line in enumerate(text.splitlines(), 1):
                running += len(line.encode("utf-8")) + 1
                if running > BYTE_BUDGET:
                    over.append(ln)
            byte_over[p] = (size, over)
    for name in sorted(store):
        for p, v in store[name].items():
            if v["eligible"] and find_index_line(index_lines(p), name) < 0:
                unindexed.append((p, name))
    return dangling, unindexed, byte_over, dupes


# ---------------------------------------------------------------------- io

def atomic_write(path, text, expect=None):
    """Write via temp + rename so a concurrent reader never sees a half file.
    `expect` guards read-modify-write: if the file changed since we read it,
    a live session got there first and we back off rather than clobber."""
    if expect is not None and os.path.exists(path):
        if read(path) != expect:
            raise RuntimeError("changed under us: %s" % path)
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".memory-sync.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def snapshots_dir():
    # Derived from VAULT at call time (not a frozen module constant) so a
    # test that monkeypatches VAULT never has snapshot() fall through to a
    # live path computed at import time.
    return os.path.join(VAULT, "snapshots")


def quarantine_dir():
    return os.path.join(VAULT, "conflicts")


def snapshot(tag="pre-sync"):
    snaps = snapshots_dir()
    os.makedirs(snaps, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y-%m-%dT%H%M%S")
    out = os.path.join(snaps, "claude-memory-%s-%s.tar.gz" % (stamp, tag))
    with tarfile.open(out, "w:gz") as tar:
        for profile in PROFILES:
            d = memdir(profile)
            if os.path.isdir(d):
                tar.add(d, arcname=profile)
    keep = sorted(f for f in os.listdir(snaps) if f.endswith(".tar.gz"))
    for old in keep[:-SNAPSHOT_KEEP]:
        os.unlink(os.path.join(snaps, old))
    with open(os.path.join(VAULT, "last-ok.json"), "w") as fh:
        json.dump({"snapshot": out, "ts": dt.datetime.now().isoformat()}, fh, indent=2)
    return out


def quarantine(name, per_profile):
    qdir = quarantine_dir()
    os.makedirs(qdir, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y-%m-%d")
    saved = []
    for p, v in sorted(per_profile.items()):
        dest = os.path.join(qdir, "%s.%s.%s.txt" % (name[:-3], p, stamp))
        if not os.path.exists(dest):
            with open(dest, "w", encoding="utf-8") as fh:
                fh.write(v["text"])
        saved.append(dest)
    return saved


def _owner_path():
    return os.path.join(LOCKDIR, "owner")


def _write_owner_token():
    token = "pid=%d host=%s started_at=%s\n" % (
        os.getpid(), socket.gethostname(), dt.datetime.now().isoformat())
    with open(_owner_path(), "w") as fh:
        fh.write(token)
    return token


def lock():
    """Acquire LOCKDIR. A stale lock (age > LOCK_STALE_SECONDS) is broken by
    renaming it aside and recreating it, so of several late callers racing a
    dead lock exactly one wins the makedirs and writes the owner token; the
    rest back off (MEM-4(d): the old code returned True for every caller that
    saw a stale lock, without recreating it or recording who held it)."""
    try:
        os.makedirs(LOCKDIR)
        _write_owner_token()
        return True
    except FileExistsError:
        try:
            age = dt.datetime.now().timestamp() - os.path.getmtime(LOCKDIR)
        except OSError:
            age = 0
        if age <= LOCK_STALE_SECONDS:
            return False
        aside = LOCKDIR + ".stale.%d.%d" % (os.getpid(), int(dt.datetime.now().timestamp()))
        try:
            os.rename(LOCKDIR, aside)
        except OSError:
            return False  # someone else already broke it; back off
        try:
            os.makedirs(LOCKDIR)
        except FileExistsError:
            return False
        _write_owner_token()
        shutil.rmtree(aside, ignore_errors=True)
        return True


def unlock():
    """Remove LOCKDIR only if the owner token still names this process --
    a caller that lost a stale-lock race must never delete the winner's
    lock (MEM-4(d))."""
    try:
        with open(_owner_path()) as fh:
            token = fh.read()
    except OSError:
        return
    if ("pid=%d " % os.getpid()) not in token:
        return
    try:
        os.unlink(_owner_path())
    except OSError:
        pass
    try:
        os.rmdir(LOCKDIR)
    except OSError:
        pass


def board(title, detail, key):
    if not os.access(FAILTASK, os.X_OK):
        return
    subprocess.run([FAILTASK, "infra", title, "--detail", detail,
                    "--dedupe-key", key, "--severity", "warn"],
                   check=False, capture_output=True)


# ----------------------------------------------------------------- provenance

def provenance_scan():
    """Every memory with no `status:` in its frontmatter, as dicts of profile,
    name, path, text, mtime and `refuse` (why it must not be defaulted, or "").
    Stores that resolve to one tree (the symlinked sisters) are scanned once."""
    out, scanned = [], set()
    for p in PROFILES:
        d = os.path.realpath(os.path.join(PROFILES[p], REL))
        if d in scanned or not os.path.isdir(d):
            continue
        scanned.add(d)
        for fn in sorted(os.listdir(d)):
            full = os.path.join(d, fn)
            if not fn.endswith(".md") or fn == INDEX or not os.path.isfile(full):
                continue
            try:
                with open(full, "rb") as fh:
                    raw = fh.read()
            except OSError:
                continue
            try:
                text, refuse = raw.decode("utf-8"), ""
            except UnicodeDecodeError:
                text, refuse = raw.decode("utf-8", "replace"), "not valid UTF-8"
            if not text.startswith("---"):
                continue
            end = text.find("\n---", 3)
            fm = text[3:end] if end > 0 else text[:4000]
            if re.search(r"^\s*status:\s*\S", fm, re.M):
                continue
            meta = frontmatter(text)
            if not refuse and not meta:
                refuse = "frontmatter not parseable"
            elif not refuse and "superseded_by" in meta:
                refuse = "has superseded_by:"
            elif not refuse and RETIRE_SIGNAL.search(meta.get("description", "")):
                refuse = "description says superseded/retired"
            out.append({"profile": p, "name": fn, "path": full, "text": text,
                        "mtime": os.path.getmtime(full), "refuse": refuse})
    return out


def stamp_status(text):
    """`text` with one line, `status: active`, inserted into its frontmatter:
    first under `metadata:` at that block's indent, else at top level."""
    m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    if not m:
        return None
    lines = m.group(1).split("\n")
    for i, ln in enumerate(lines):
        if re.match(r"^metadata:\s*$", ln):
            nxt = re.match(r"^(\s+)\S", lines[i + 1]) if i + 1 < len(lines) else None
            lines.insert(i + 1, (nxt.group(1) if nxt else "  ") + "status: active")
            break
    else:
        lines.append("status: active")
    return "---\n" + "\n".join(lines) + "\n---\n" + text[m.end():]


def stamp_default_status():
    """Writing runs only: stamp `status: active` on each memory that lacks a
    status and carries no retirement signal. Snapshot first; every write is a
    one-line insertion proven by superset() and guarded by atomic_write(expect=)
    against a live session editing the same file. Returns the snapshot path,
    or None if nothing needed stamping (so the run takes one snapshot, not two)."""
    now = dt.datetime.now().timestamp()
    todo = [x for x in provenance_scan()
            if not x["refuse"] and now - x["mtime"] >= FRESH_SECONDS]
    snap = snapshot("pre-stamp") if todo else None
    if snap:
        print("  snapshot: %s" % snap)
    for x in todo:
        new = stamp_status(x["text"])
        if new is None or not superset(new, x["text"]):
            print("  SKIP   stamp %s: %s (insertion not provably lossless)"
                  % (x["profile"], x["name"]), file=sys.stderr)
            continue
        try:
            atomic_write(x["path"], new, expect=x["text"])
            # Keep the author's mtime: the stamp is not an edit, and a fresh
            # mtime would DEFER this file's ADD/PROMOTE below as "mid-edit".
            os.utime(x["path"], (x["mtime"], x["mtime"]))
            print("  stamped  status: active  %s: %s" % (x["profile"], x["name"]))
        except RuntimeError as e:
            print("  SKIP   stamp %s (%s)" % (x["path"], e), file=sys.stderr)
    return snap


# --------------------------------------------------------------------- retire

def retire(name, apply_it):
    if not name.endswith(".md"):
        name += ".md"
    hits = []
    for profile in PROFILES:
        f = os.path.join(memdir(profile), name)
        idx = find_index_line(index_lines(profile), name)
        if os.path.exists(f) or idx >= 0:
            hits.append((profile, os.path.exists(f), idx >= 0))
    if not hits:
        print("retire: %s is present in no store" % name)
        return 0
    for profile, has_file, has_idx in hits:
        print("  %-10s file=%s index=%s" % (profile, has_file, has_idx))
    if not apply_it:
        print("\ndry run — rerun with --apply to remove")
        return 0
    snap = snapshot("pre-retire")
    print("snapshot: %s" % snap)
    for profile, has_file, has_idx in hits:
        if has_file:
            os.unlink(os.path.join(memdir(profile), name))
        if has_idx:
            lines = index_lines(profile)
            j = find_index_line(lines, name)
            before = read(index_path(profile))
            del lines[j]
            atomic_write(index_path(profile), "\n".join(lines) + "\n", expect=before)
    print("retired %s from %d store(s)" % (name, len(hits)))
    return 0


# ----------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(add_help=True, description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--scheduled", action="store_true")
    ap.add_argument("--retire", metavar="NAME")
    ap.add_argument("--selfcheck", action="store_true",
                    help="is the installed copy identical to the repo source")
    ap.add_argument("--verbose", "-v", action="store_true")
    args = ap.parse_args()

    if args.selfcheck:
        src = os.path.join(HOME, "Projects", "estate-watch", "local-tools", "memory-sync")
        inst = os.path.join(HOME, ".claude", "bin", "memory-sync")
        if not os.path.exists(src):
            print("selfcheck: no repo source at %s (running unversioned)" % src)
            return 1
        if not os.path.exists(inst):
            print("selfcheck: NOT INSTALLED at %s" % inst)
            return 1
        if sha(read(src)) != sha(read(inst)):
            print("selfcheck: DRIFT — installed copy differs from %s" % src)
            print("  fix: install -m 0755 %s %s" % (src, inst))
            return 1
        print("selfcheck: installed copy is identical to the repo source")
        return 0

    if args.retire:
        return retire(args.retire, args.apply)

    writing = args.apply or args.scheduled
    if writing and not lock():
        print("memory-sync: another run holds the lock; skipping", file=sys.stderr)
        return 0

    try:
        # Before scan(), so ADD/PROMOTE carry the stamped text.
        pre_snap = stamp_default_status() if writing else None
        store = scan()
        adds, promotes, conflicts, divergent = [], [], [], []
        clean = skipped = 0
        now = dt.datetime.now().timestamp()

        for name in sorted(store):
            per = store[name]
            action, winner, detail = decide(name, per)
            if action == "skip":
                skipped += 1
                continue
            if action == "clean":
                clean += 1
                continue
            fresh = [p for p, v in per.items() if now - v["mtime"] < FRESH_SECONDS]
            if fresh and writing:
                print("  DEFER  %-46s touched <%ds ago in %s"
                      % (name, FRESH_SECONDS, ",".join(fresh)))
                continue
            if action == "conflict":
                conflicts.append((name, per))
            elif action == "divergent-ineligible":
                divergent.append((name, per, detail))
            elif action == "add":
                adds.append((name, winner, per, detail))
            else:
                promotes.append((name, winner, per, detail))

        # ---- report
        print("memory-sync %s  (%s)"
              % ("APPLY" if writing else ("CHECK" if args.check else "DRY RUN"),
                 dt.datetime.now().strftime("%Y-%m-%d %H:%M")))
        print("  stores: " + "  ".join(
            "%s=%d" % (p, len([n for n in store if p in store[n]])) for p in PROFILES))
        print("  in sync: %d doctrine-grade · local-only: %d" % (clean, skipped))
        print()

        for name, src, per, why in adds:
            missing = [p for p in PROFILES if p not in per]
            print("  ADD      %-46s %s -> %s" % (name, src, ",".join(sorted(missing))))
            if args.verbose:
                print("           %s | %s" % (per[src]["reason"], why))

        for name, w, per, why in promotes:
            losers = sorted([p for p in per if p != w] + [p for p in PROFILES if p not in per])
            print("  PROMOTE  %-46s %s -> %s" % (name, w, ",".join(losers)))
            print("           %s" % why)
            for l in losers:
                if l not in per:
                    print("           %s: absent, will be created (0 line(s) lost)" % l)
                    continue
                if per[l]["sha"] == per[w]["sha"]:
                    continue
                gone = lost_lines(per[w]["text"], per[l]["text"])
                print("           %s: %d bytes -> %d, %d line(s) lost (0 = provably safe)"
                      % (l, len(per[l]["text"]), len(per[w]["text"]), len(gone)))
            if args.verbose:
                for l in losers:
                    if l in per and per[l]["sha"] != per[w]["sha"]:
                        for d in list(difflib.unified_diff(
                                per[l]["text"].splitlines(), per[w]["text"].splitlines(),
                                l, w, lineterm="", n=0))[:14]:
                            print("           | " + d[:150])

        for name, per, why in divergent:
            print("  NOTE     %-46s divergent-ineligible: %s" % (name, why))

        for name, per in conflicts:
            print("  CONFLICT %-46s no copy contains all the others" % name)
            for p, v in sorted(per.items()):
                print("           %-10s %6d bytes  sha %s  modified %s"
                      % (p, len(v["text"]), v["sha"][:8], v["modified"] or "-"))
            for a in sorted(per):
                for b in sorted(per):
                    if a < b and per[a]["sha"] != per[b]["sha"]:
                        print("           %s has %d line(s) %s lacks; %s has %d that %s lacks"
                              % (a, len(lost_lines(per[b]["text"], per[a]["text"])), b,
                                 b, len(lost_lines(per[a]["text"], per[b]["text"])), a))

        # index plan
        index_ops = []
        for name, src, per, _ in adds:
            index_ops += plan_index(name, src, [p for p in PROFILES if p != src])
        for name, w, per, _ in promotes:
            index_ops += plan_index(name, w, [p for p in PROFILES if p != w])
        if index_ops:
            print()
            for p, mode, name, payload in index_ops:
                print("  INDEX    %-8s %-8s %s" % (p, mode, payload[:96]))

        # Index hygiene (MEM-3, CD-R4-1): dangling links and unindexed
        # eligible memories now FAIL --check, per registered profile; the
        # byte budget only WARNS. Applying sync never invents or removes an
        # index line on its own beyond the ADD/PROMOTE segments above.
        dangling, unindexed, byte_over, dupes = index_health(store)
        unreg = unregistered_profile_dirs()
        if dangling or unindexed or byte_over or dupes or unreg:
            print()
            for d in unreg:
                print("  NOTE     unregistered profile dir  %s (has %s, not in PROFILES)"
                      % (d, os.path.join(REL, INDEX)))
            for p, ln, target in dangling:
                print("  NOTE     dangling index link  %s line %d -> %s (missing)" % (p, ln, target))
            for p, name in unindexed:
                print("  NOTE     unindexed eligible memory  %s: %s" % (p, name))
            for p, (size, over) in sorted(byte_over.items()):
                print("  NOTE     %s MEMORY.md is %d bytes (budget %d); entries past boundary at line(s) %s"
                      % (p, size, BYTE_BUDGET, ", ".join(str(l) for l in over)))
            for d in dupes:
                print("  NOTE     duplicate index line  %s" % d)
            print("           (index hygiene; sync never invents or removes an index line "
                  "beyond the segment(s) above)")

        print()
        print("  totals: %d add · %d promote · %d conflict · %d divergent-ineligible · %d index line(s)"
              % (len(adds), len(promotes), len(conflicts), len(divergent), len(index_ops)))

        # Provenance (memory-sisters design, decision 5, Jeff 2026-09-07): every
        # memory carries `status:` (active | superseded | retired), so a retired
        # rule can never be mistaken for a live one by a sister that only reads
        # the file. Writing runs stamp the default on plain new memories
        # (stamp_default_status). --check fails on a memory that must not be
        # defaulted (it says it is superseded/retired, or cannot be parsed) and
        # on one older than STAMP_GRACE_SECONDS that is still unstamped.
        no_status, pending = [], []
        for x in provenance_scan():
            label = "%s: %s" % (x["profile"], x["name"])
            if x["refuse"]:
                no_status.append("%s (not defaulted: %s)" % (label, x["refuse"]))
            elif now - x["mtime"] < STAMP_GRACE_SECONDS:
                pending.append(label)
            else:
                no_status.append(label)
        if no_status or pending:
            print()
            for n in pending[:40]:
                print("  NOTE     provenance pending: %s (next scheduled run stamps status: active)" % n)
            for n in no_status[:40]:
                print("  PROVENANCE missing status: %s" % n)
            if len(no_status) > 40:
                print("  PROVENANCE ... %d more" % (len(no_status) - 40))
            if no_status:
                print("           (set status: active | superseded | retired under metadata: by hand; "
                      "--check fails until every one carries one)")
                if args.scheduled:
                    board("memory-sync: %d memory file(s) need a status by hand" % len(no_status),
                          "memory-sync did not default these to status: active:\n  %s\n"
                          "Set status under metadata:, then rerun ~/.claude/bin/memory-sync --check"
                          % "\n  ".join(no_status[:40]),
                          "memory-sync-provenance-" + sha(" ".join(no_status))[:12])

        if args.check:
            if conflicts:
                return 2
            if adds or promotes or divergent or dangling or unindexed or unreg or no_status:
                return 1
            return 0

        if not writing:
            if adds or promotes or conflicts:
                print("\n  dry run — nothing written. Apply with: memory-sync --apply")
            return 2 if conflicts else 0

        # ---- apply
        if adds or promotes:
            snap = pre_snap or snapshot()
            print("\n  snapshot: %s" % snap)
            for name, src, per, _ in adds + [(n, w, p, d) for n, w, p, d in promotes]:
                text = per[src]["text"]
                for p in PROFILES:
                    dest = os.path.join(memdir(p), name)
                    if p == src:
                        continue
                    try:
                        cur = read(dest) if os.path.exists(dest) else None
                        if cur == text:
                            continue
                        atomic_write(dest, text, expect=cur)
                        print("  wrote  %s/%s" % (p, name))
                    except RuntimeError as e:
                        print("  SKIP   %s (%s)" % (dest, e), file=sys.stderr)
            for p, mode, name, payload in index_ops:
                try:
                    if write_index(p, name, payload, mode):
                        print("  index  %s %s %s" % (p, mode, name))
                except RuntimeError as e:
                    print("  SKIP   index %s (%s)" % (p, e), file=sys.stderr)

        if conflicts:
            names = ", ".join(n for n, _ in conflicts)
            for name, per in conflicts:
                saved = quarantine(name, per)
            print("\n  %d conflict(s) NOT written; copies quarantined in %s"
                  % (len(conflicts), quarantine_dir()))
            if args.scheduled:
                board("memory-sync: %d doctrine memory conflict(s)" % len(conflicts),
                      "Divergent copies with no containing version: %s\n"
                      "Nothing was written. Byte-exact copies of every side are in %s\n"
                      "Resolve by hand, then rerun: ~/.claude/bin/memory-sync --apply"
                      % (names, quarantine_dir()),
                      "memory-sync-conflict-" + sha(names)[:12])
            return 2
        return 0
    finally:
        if writing:
            unlock()


if __name__ == "__main__":
    sys.exit(main())
