#!/bin/bash
# Headless Claude launcher for launchd jobs.
# Prefers a long-lived token (claude setup-token) over the interactive login,
# so scheduled jobs survive login expiry. Loud fallback, never silent.
#
# One-time setup per account: run `claude setup-token`, then put the token in
#   ~/.claude/secrets/claude-headless.env   as: CLAUDE_CODE_OAUTH_TOKEN=<token>
# A job can point at a different account's env via CLAUDE_HEADLESS_ENV=<path>.
ENV_FILE="${CLAUDE_HEADLESS_ENV:-$HOME/.claude/secrets/claude-headless.env}"
if [ -f "$ENV_FILE" ]; then
  set -a; . "$ENV_FILE"; set +a
fi
if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
  echo "claude-headless: NO long-lived token ($ENV_FILE absent/empty); depending on interactive login state — run 'claude setup-token' to fix durably" >&2
fi
# Pin a model unless the caller chose one. The ~/.claude profile defaults to
# Fable, which scheduled jobs must never spend (RULE #1); on 2026-10-16 the
# bundle daily died "out of usage credits" because it inherited that default.
# Scheduled jobs and routines are not authorized for Fable at all (Jeff
# 2026-10-16). Read only the model argument, never the prompt text.
want="${CLAUDE_HEADLESS_MODEL:-opus}"; prev=""; has_model=0
for a in "$@"; do
  case "$a" in --model=*) want="${a#--model=}"; has_model=1 ;; esac
  [ "$prev" = "--model" ] && { want="$a"; has_model=1; }
  prev="$a"
done
case "$want" in
  *[Ff]able*)
    echo "claude-headless: REFUSED model '$want', Fable is not authorized for scheduled jobs (Jeff 2026-10-16)" >&2
    exit 64 ;;
esac
if [ "$has_model" = 1 ]; then
  exec "$HOME/.local/bin/claude" "$@"
fi
exec "$HOME/.local/bin/claude" --model "$want" "$@"
