<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- deliverables-sweep: nightly 03:35 sweep of ~/Projects for deliverables that
       are not yet logged in the Notes Vault (~/.claude/bin/deliverables-sweep.py,
       versioned here as local-tools/deliverables-sweep.py since 2026-09-23).
       Interpreter: Homebrew 3.12, present on both Macs; the laptop's copy used to
       pin the python.org framework build, which the Mac Studio does not have
       (vault note 2947, Wave 0.3). The script is stdlib-only.
       Install: cp to ~/Library/LaunchAgents and launchctl bootstrap gui/$UID <path>. -->
  <key>Label</key><string>com.jeffpinto.deliverables-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jeffpinto/.claude/bin/runlog</string>
    <string>--tag</string>
    <string>deliverables-sweep</string>
    <string>/opt/homebrew/bin/python3.12</string>
    <string>/Users/jeffpinto/.claude/bin/deliverables-sweep.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/jeffpinto</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>35</integer></dict>
  <key>StandardOutPath</key><string>/Users/jeffpinto/Library/Logs/deliverables-sweep.log</string>
  <key>StandardErrorPath</key><string>/Users/jeffpinto/Library/Logs/deliverables-sweep.log</string>
</dict>
</plist>
