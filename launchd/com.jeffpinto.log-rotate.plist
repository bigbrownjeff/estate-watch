<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jeffpinto.log-rotate</string>
  <key>ProgramArguments</key><array>
    <string>/Users/jeffpinto/.claude/bin/runlog</string><string>--tag</string><string>log-rotate</string>
    <string>/usr/bin/python3</string><string>/Users/jeffpinto/.claude/bin/log-rotate.py</string><string>--apply</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>/Users/jeffpinto/.claude/logs/log-rotate.log</string>
  <key>StandardErrorPath</key><string>/Users/jeffpinto/.claude/logs/log-rotate.err</string>
</dict></plist>
